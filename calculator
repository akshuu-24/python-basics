    "# calculator program\n",
    "a = float(input(\"enter first number:\"))\n",
    "b = float(input(\"enter second number:\"))\n",
    "operator = input( \"enter operator (+,-,*,/):\")\n",
    "if operator == \"+\":\n",
    "    print(\"answer =\", a+b)\n",
    "elif operator == \"-\":\n",
    "    print(\"answer =\", a-b)\n",
    "elif operator == \"*\": \n",
    "    print(\"answer =\", a*b)\n",
    "elif operator == \"/\":\n",
    "    print(\"answer =\", a/b)\n",
    "\n",
